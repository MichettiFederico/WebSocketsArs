  .card-row{grid-template-columns:repeat(2,1fr);}
  .dash-grid{grid-template-columns:1fr;}
  .field-row{grid-template-columns:1fr;}
  header{padding:14px 18px;}
  .workspace{padding:18px;}
  table{font-size:12px;}
