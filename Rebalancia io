.alloc-row-input{display:grid; grid-template-columns:1fr 90px auto; gap:8px; align-items:center; margin-bottom:8px;}
.alloc-row-input select, .alloc-row-input input{background:#0e1729; border:1px solid var(--border-soft); border-radius:6px; padding:7px 9px; color:var(--text-main); font-size:12.5px;}
.alloc-total{font-size:11.5px; color:var(--text-muted); margin:4px 0 14px;}
.alloc-total.warn{color:var(--amber);}

