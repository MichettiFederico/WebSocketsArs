:root{
  --bg-body:#0b1220; --bg-panel:#111b2e; --bg-card:#152238; --bg-card-hover:#1c2d4a;
  --border:#243755; --border-soft:#1a2740;
  --text-main:#eef2f8; --text-muted:#8091ac; --text-dim:#4d6182;
  --accent:#22c58b; --accent-dim:#1a9b6e; --blue:#4c8dff; --amber:#f5a524; --red:#f2495c;
  --mono:'JetBrains Mono', monospace;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',sans-serif; background:var(--bg-body); color:var(--text-main); display:flex; height:100vh; overflow:hidden; font-size:14px; -webkit-font-smoothing:antialiased;}
@media (prefers-reduced-motion: reduce){ *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;} }

aside{width:230px; background:#070c16; border-right:1px solid var(--border-soft); padding:24px 14px; display:flex; flex-direction:column; justify-content:space-between; flex-shrink:0; overflow-y:auto;}
.brand{display:flex; align-items:center; gap:9px; padding:0 8px 26px;}
.brand-mark{width:26px; height:26px; border-radius:7px; background:linear-gradient(155deg,var(--accent),#0e6b48); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; color:#04120c; flex-shrink:0;}
.brand-name{font-size:15px; font-weight:700; letter-spacing:-0.01em;}
.brand-name em{font-style:normal; color:var(--text-dim); font-weight:500;}
nav{display:flex; flex-direction:column; gap:2px;}
.nav-item{padding:9px 12px; color:var(--text-muted); border-radius:7px; font-weight:500; cursor:pointer; display:flex; align-items:center; gap:10px; border-left:2px solid transparent; transition:background .15s, color .15s; font-size:13.5px;}
.nav-item:hover{background:#0e1729; color:var(--text-main);}
.nav-item.active{background:var(--bg-card); color:var(--text-main); border-left-color:var(--accent);}
.nav-icon{width:16px; text-align:center; opacity:.85;}
.nav-count{margin-left:auto; font-family:var(--mono); font-size:10.5px; color:var(--text-dim);}
.sidebar-foot{padding:0 8px; display:flex; flex-direction:column; gap:10px;}
.env-pill{font-family:var(--mono); font-size:10.5px; color:var(--text-dim); background:#0e1729; border:1px solid var(--border-soft); border-radius:5px; padding:6px 9px; text-align:center;}
.user-chip{display:flex; align-items:center; gap:9px; padding:8px; border-radius:8px; background:#0e1729;}
.user-avatar{width:26px; height:26px; border-radius:50%; background:#2a3a58; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--text-muted);}
.user-meta{line-height:1.25;}
.user-name{font-size:12px; font-weight:600;}
.user-role{font-size:11px; color:var(--text-dim);}

main{flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0;}
header{background:#070c16; border-bottom:1px solid var(--border-soft); padding:14px 30px; display:flex; justify-content:space-between; align-items:center; flex-shrink:0;}
.conn-label{color:var(--text-muted); font-weight:500; font-size:13px;}
.conn-status{display:flex; gap:16px; font-family:var(--mono); font-size:11.5px; flex-wrap:wrap;}
.dot{width:6px; height:6px; border-radius:50%; background:var(--accent); display:inline-block; margin-right:6px; box-shadow:0 0 0 3px rgba(34,197,139,.15);}
.dot.off{background:var(--text-dim); box-shadow:none;}
.conn-status span{color:var(--text-muted); display:flex; align-items:center;}

.view{display:none; overflow-y:auto; flex:1;}
.view.active{display:block;}
.workspace{padding:30px; display:flex; flex-direction:column; gap:22px; max-width:1220px; margin:0 auto; width:100%;}

.page-header{display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap;}
.page-header h1{font-size:1.4rem; font-weight:700; letter-spacing:-0.01em; margin-bottom:4px;}
.page-header p{color:var(--text-muted); font-size:13px;}

.btn{border:none; padding:10px 18px; border-radius:7px; font-weight:600; cursor:pointer; font-size:13.5px; font-family:'Inter',sans-serif; transition:filter .15s, transform .1s;}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--accent); color:#04150e;}
.btn-primary:hover{filter:brightness(1.08);}
.btn-primary:disabled{opacity:.45; cursor:not-allowed; filter:none;}
.btn-ghost{background:transparent; border:1px solid var(--border); color:var(--text-muted);}
.btn-ghost:hover{color:var(--text-main); border-color:#3a5075;}
.btn-sm{padding:5px 11px; font-size:12px; border-radius:6px;}
.btn-danger-outline{background:transparent; border:1px solid rgba(242,73,92,.4); color:var(--red);}
.btn-danger-outline:hover{background:rgba(242,73,92,.08);}

.card-row{display:grid; grid-template-columns:repeat(4,1fr); gap:14px;}
.metric-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:16px 18px;}
.metric-label{color:var(--text-dim); font-size:11.5px; margin-bottom:6px; font-weight:600;}
.metric-value{font-size:1.3rem; font-weight:700; letter-spacing:-0.01em;}
.metric-sub{font-size:11.5px; color:var(--text-muted); margin-top:3px;}

.progress-wrap{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:16px 18px; display:flex; align-items:center; gap:16px;}
.progress-track{flex:1; height:7px; border-radius:99px; background:#0e1729; overflow:hidden;}
.progress-fill{height:100%; width:0%; background:linear-gradient(90deg,var(--accent-dim),var(--accent)); border-radius:99px; transition:width .5s ease;}
.progress-count{font-family:var(--mono); font-size:12.5px; color:var(--text-muted); white-space:nowrap;}

.toolbar{display:flex; gap:10px; align-items:center; flex-wrap:wrap;}
.search-box{flex:1; min-width:180px; display:flex; align-items:center; gap:8px; background:var(--bg-card); border:1px solid var(--border-soft); border-radius:7px; padding:8px 12px;}
.search-box input{background:transparent; border:none; outline:none; color:var(--text-main); font-size:13px; width:100%;}
.search-box input::placeholder{color:var(--text-dim);}
.filter-chip{background:var(--bg-card); border:1px solid var(--border-soft); color:var(--text-muted); padding:8px 13px; border-radius:7px; font-size:12.5px; font-weight:500; cursor:pointer; white-space:nowrap; transition:.15s;}
.filter-chip.active{border-color:var(--accent); color:var(--accent); background:rgba(34,197,139,.08);}
.filter-chip:hover{color:var(--text-main);}

.table-container{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; overflow:hidden; overflow-x:auto;}
table{width:100%; border-collapse:collapse; text-align:left;}
th{background:#0e1729; color:var(--text-dim); padding:11px 16px; font-size:11px; font-weight:600; letter-spacing:.02em; border-bottom:1px solid var(--border-soft); white-space:nowrap;}
td{padding:13px 16px; border-bottom:1px solid var(--border-soft); font-size:13px; vertical-align:middle;}
tbody tr{transition:background .12s;}
tbody tr:last-child td{border-bottom:none;}
tbody tr.clickable{cursor:pointer;}
tbody tr.clickable:hover td{background:var(--bg-card-hover);}
.client-name{font-weight:600;}
.client-id{color:var(--text-dim); font-size:11.5px; font-family:var(--mono);}
.badge-broker{padding:3px 8px; border-radius:5px; font-size:10.5px; font-weight:600; background:#0e1729; border:1px solid var(--border-soft); color:var(--text-muted); font-family:var(--mono);}
.badge-risk{padding:3px 8px; border-radius:5px; font-size:10.5px; font-weight:600;}
.badge-risk.conservador{background:rgba(76,141,255,.12); color:var(--blue);}
.badge-risk.moderado{background:rgba(245,165,36,.12); color:var(--amber);}
.badge-risk.agresivo{background:rgba(242,73,92,.12); color:var(--red);}
.tag-buy{color:var(--accent); font-weight:700;}
.tag-sell{color:var(--red); font-weight:700;}
.amount{font-family:var(--mono); font-variant-numeric:tabular-nums;}
.deviation{font-family:var(--mono); font-weight:700;}
.deviation.neg{color:var(--red);}
.deviation.pos{color:var(--amber);}
.deviation.flat{color:var(--text-muted);}
input[type="checkbox"].row-check{width:15px; height:15px; accent-color:var(--accent); cursor:pointer;}

.status{display:inline-flex; align-items:center; gap:7px; font-weight:600; font-size:12px;}
.status-pending{color:var(--text-dim);}
.status-api{color:var(--blue);}
.status-ws-partial{color:var(--amber);}
.status-done{color:var(--accent);}
.status-error{color:var(--red);}
.spinner{width:11px; height:11px; border:2px solid transparent; border-top-color:currentColor; border-radius:50%; animation:spin .8s linear infinite;}
@keyframes spin{100%{transform:rotate(360deg);}}
.pulse-dot{width:6px; height:6px; border-radius:50%; background:currentColor; animation:pulse 1.4s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.retry-link{background:none; border:none; color:var(--red); text-decoration:underline; font-size:11.5px; cursor:pointer; font-weight:600; margin-left:4px;}
.row-remove{background:none; border:none; color:var(--text-dim); font-size:14px; cursor:pointer; padding:2px 6px;}
.row-remove:hover{color:var(--red);}

.log-panel{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:0; overflow:hidden;}
.log-head{padding:12px 18px; border-bottom:1px solid var(--border-soft); font-weight:600; font-size:12.5px; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center;}
.log-body{max-height:180px; overflow-y:auto; padding:6px 0;}
.log-body:empty::after{content:'Sin eventos todavía. Agregá órdenes o iniciá el rebalanceo para ver la actividad en vivo.'; display:block; padding:20px 18px; color:var(--text-dim); font-size:12.5px;}
.log-row{padding:6px 18px; font-family:var(--mono); font-size:11.5px; color:var(--text-muted); display:flex; gap:10px; animation:fadeIn .25s ease;}
@keyframes fadeIn{from{opacity:0; transform:translateY(-2px);}to{opacity:1; transform:translateY(0);}}
.log-time{color:var(--text-dim); flex-shrink:0;}

.stats-strip{display:flex; gap:14px; flex-wrap:wrap;}
.stat-pill{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:9px; padding:12px 16px; flex:1; min-width:140px;}
.stat-pill .metric-value{font-size:1.1rem;}

.dash-grid{display:grid; grid-template-columns:1.4fr 1fr; gap:16px;}
.panel{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:18px 20px;}
.panel h3{font-size:13px; font-weight:600; margin-bottom:14px; color:var(--text-main);}
.bar-row{display:flex; align-items:center; gap:10px; margin-bottom:10px;}
.bar-label{width:80px; font-size:12px; color:var(--text-muted); flex-shrink:0;}
.bar-track{flex:1; height:8px; background:#0e1729; border-radius:99px; overflow:hidden;}
.bar-fill{height:100%; border-radius:99px;}
.bar-val{width:56px; text-align:right; font-family:var(--mono); font-size:11.5px; color:var(--text-muted);}
.activity-item{display:flex; gap:10px; padding:9px 0; border-bottom:1px solid var(--border-soft); font-size:12.5px;}
.activity-item:last-child{border-bottom:none;}
.activity-dot{width:6px; height:6px; border-radius:50%; margin-top:5px; flex-shrink:0;}
.activity-text{color:var(--text-muted); line-height:1.4;}
.activity-text strong{color:var(--text-main); font-weight:600;}

.empty-state{text-align:center; padding:50px 20px; color:var(--text-dim);}
.empty-state .emoji{font-size:28px; margin-bottom:10px; opacity:.6;}
.empty-state p{font-size:13px;}

.model-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px;}
.model-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:18px; cursor:pointer; transition:border-color .15s;}
.model-card:hover{border-color:#3a5075;}
.model-card.selected{border-color:var(--accent); background:rgba(34,197,139,.05);}
.model-card-head{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;}
.model-name{font-weight:700; font-size:14px;}
.model-badge{font-size:10px; font-weight:700; color:var(--accent); background:rgba(34,197,139,.12); padding:3px 8px; border-radius:5px; white-space:nowrap;}
.alloc-bar{height:8px; border-radius:99px; background:#0e1729; display:flex; overflow:hidden; margin:10px 0 8px;}
.alloc-seg{height:100%;}
.alloc-legend{display:flex; flex-wrap:wrap; gap:8px 14px; font-size:11px; color:var(--text-muted);}
.legend-dot{width:7px; height:7px; border-radius:2px; display:inline-block; margin-right:5px;}

.conn-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:14px;}
.conn-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:18px;}
.conn-card-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;}
.conn-name{font-weight:700; font-size:14px;}
.conn-type{font-size:11.5px; color:var(--text-dim); margin-bottom:14px;}
.switch{position:relative; width:38px; height:21px; flex-shrink:0;}
.switch input{opacity:0; width:0; height:0;}
.slider{position:absolute; inset:0; background:#2a3a58; border-radius:99px; cursor:pointer; transition:.2s;}
.slider::before{content:''; position:absolute; width:15px; height:15px; left:3px; top:3px; background:#fff; border-radius:50%; transition:.2s;}
input:checked + .slider{background:var(--accent);}
input:checked + .slider::before{transform:translateX(17px);}
.conn-status-line{display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-muted);}
.conn-actions{margin-top:12px;}

.settings-panel{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:10px; padding:22px; max-width:560px;}
.settings-panel h3{font-size:13px; font-weight:600; margin-bottom:16px;}
.toggle-row{display:flex; justify-content:space-between; align-items:center; padding:11px 0; border-bottom:1px solid var(--border-soft); gap:12px;}
.toggle-row:last-child{border-bottom:none;}
.toggle-row-label{font-size:13px;}
.toggle-row-sub{font-size:11.5px; color:var(--text-dim); margin-top:2px;}
.plan-badge{display:inline-flex; align-items:center; gap:8px; background:rgba(34,197,139,.1); border:1px solid rgba(34,197,139,.25); color:var(--accent); padding:8px 14px; border-radius:8px; font-size:12.5px; font-weight:600;}

.modal-overlay{position:fixed; inset:0; background:rgba(4,8,16,.65); backdrop-filter:blur(2px); display:none; align-items:center; justify-content:center; z-index:50; animation:fadeIn .15s ease; padding:20px;}
.modal-overlay.show{display:flex;}
.modal{background:var(--bg-panel); border:1px solid var(--border); border-radius:12px; width:440px; max-width:100%; max-height:90vh; overflow-y:auto; padding:24px; box-shadow:0 20px 50px rgba(0,0,0,.4); position:relative;}
.modal h2{font-size:1.05rem; margin-bottom:4px;}
.modal .modal-sub{color:var(--text-muted); font-size:12.5px; margin-bottom:18px;}
.modal-row{display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--border-soft); font-size:13px;}
.modal-row:last-child{border-bottom:none;}
.modal-row span:first-child{color:var(--text-muted);}
.modal-row span:last-child{font-weight:600; font-family:var(--mono);}
.modal-actions{display:flex; gap:10px; margin-top:20px;}
.modal-close{position:absolute; top:16px; right:16px; background:none; border:none; color:var(--text-dim); font-size:18px; cursor:pointer;}

.field{margin-bottom:14px;}
.field label{display:block; font-size:12px; font-weight:600; color:var(--text-muted); margin-bottom:6px;}
.field input, .field select{width:100%; background:#0e1729; border:1px solid var(--border-soft); border-radius:7px; padding:9px 11px; color:var(--text-main); font-size:13px; font-family:'Inter',sans-serif; outline:none; transition:border-color .15s;}
.field input:focus, .field select:focus{border-color:var(--blue);}
.field-row{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
.field-hint{font-size:11px; color:var(--text-dim); margin-top:4px;}
.compute-box{background:#0e1729; border:1px solid var(--border-soft); border-radius:8px; padding:12px 14px; display:flex; justify-content:space-between; align-items:center; margin-top:4px;}
.compute-box .label{font-size:12px; color:var(--text-muted);}
.compute-box .value{font-family:var(--mono); font-weight:700; font-size:15px;}
.form-error{color:var(--red); font-size:12px; margin-top:-6px; margin-bottom:12px; display:none;}
.form-error.show{display:block;}
.alloc-row-input{display:grid; grid-template-columns:1fr 90px auto; gap:8px; align-items:center; margin-bottom:8px;}
.alloc-row-input select, .alloc-row-input input{background:#0e1729; border:1px solid var(--border-soft); border-radius:6px; padding:7px 9px; color:var(--text-main); font-size:12.5px;}
.alloc-total{font-size:11.5px; color:var(--text-muted); margin:4px 0 14px;}
.alloc-total.warn{color:var(--amber);}

@media (max-width:920px){
  aside{position:fixed; left:-230px; z-index:40; height:100vh; transition:left .2s;}
  .card-row{grid-template-columns:repeat(2,1fr);}
  .dash-grid{grid-template-columns:1fr;}
  .field-row{grid-template-columns:1fr;}
  header{padding:14px 18px;}
  .workspace{padding:18px;}
  table{font-size:12px;}
  th,td{padding:10px 12px;}
}

button:focus-visible, input:focus-visible, select:focus-visible, .nav-item:focus-visible, tr:focus-visible{outline:2px solid var(--blue); outline-offset:2px;}
::-webkit-scrollbar{width:9px; height:9px;}
::-webkit-scrollbar-thumb{background:#233250; border-radius:99px;}
::-webkit-scrollbar-track{background:transparent;}

#toast{position:fixed; bottom:22px; right:22px; background:var(--accent); color:#04150e; padding:14px 20px; border-radius:9px; font-weight:700; font-size:13px; display:flex; align-items:center; gap:10px; transform:translateY(90px); opacity:0; transition:all .3s cubic-bezier(.2,.8,.2,1); box-shadow:0 14px 30px rgba(0,0,0,.35); z-index:60;}
#toast.show{transform:translateY(0); opacity:1;}
